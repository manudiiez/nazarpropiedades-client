# De dónde salen los datos: `api` (API real) o `mock` (fixtures en disco).
# Con `mock` no hace falta ninguna URL y el sitio levanta sin backend.
DATA_SOURCE=api

# URL de la API. La usa SOLO el server de Next: ningún pedido sale del browser,
# ni siquiera el POST del formulario de consultas (va por Server Action).
#
# Es variable de RUNTIME, no build-arg, y no hay ninguna NEXT_PUBLIC_*: por eso
# la misma imagen vX.Y.Z sirve staging y producción cambiando solo esto.
API_URL=http://localhost:8000/api/v1
