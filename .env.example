# De dónde salen los datos: `api` (API real) o `mock` (fixtures en disco).
# Con `mock` no hace falta ninguna URL y el sitio levanta sin backend.
DATA_SOURCE=api

# URL de la API para las lecturas. La usa SOLO el server de Next.
# Es variable de RUNTIME, no build-arg: la misma imagen sirve staging y producción.
API_URL=http://localhost:8000/api/v1

# URL de la API accesible desde el browser, para el POST del formulario de
# consultas, que no puede proxearse por el server (el rate limit de 5/min se
# contaría contra la IP del server). Se hornea en el build.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
